module unit Console;

cppstart header
#include <iostream>
cppend

// ---------------------------------------------------------------------------
// ANSI Color Constants
// ---------------------------------------------------------------------------

// Text styles
public const
  clReset: string = "\x1B[0m";
  clBold: string = "\x1B[1m";
  clDim: string = "\x1B[2m";
  clItalic: string = "\x1B[3m";
  clUnderline: string = "\x1B[4m";
  clBlink: string = "\x1B[5m";
  clReverse: string = "\x1B[7m";
  clHidden: string = "\x1B[8m";
  clStrikethrough: string = "\x1B[9m";

// Foreground colors
public const
  clBlack: string = "\x1B[30m";
  clRed: string = "\x1B[31m";
  clGreen: string = "\x1B[32m";
  clYellow: string = "\x1B[33m";
  clBlue: string = "\x1B[34m";
  clMagenta: string = "\x1B[35m";
  clCyan: string = "\x1B[36m";
  clWhite: string = "\x1B[37m";
  clDefault: string = "\x1B[39m";

// Bright foreground colors
public const
  clBrightBlack: string = "\x1B[90m";
  clBrightRed: string = "\x1B[91m";
  clBrightGreen: string = "\x1B[92m";
  clBrightYellow: string = "\x1B[93m";
  clBrightBlue: string = "\x1B[94m";
  clBrightMagenta: string = "\x1B[95m";
  clBrightCyan: string = "\x1B[96m";
  clBrightWhite: string = "\x1B[97m";

// Background colors
public const
  clBgBlack: string = "\x1B[40m";
  clBgRed: string = "\x1B[41m";
  clBgGreen: string = "\x1B[42m";
  clBgYellow: string = "\x1B[43m";
  clBgBlue: string = "\x1B[44m";
  clBgMagenta: string = "\x1B[45m";
  clBgCyan: string = "\x1B[46m";
  clBgWhite: string = "\x1B[47m";
  clBgDefault: string = "\x1B[49m";

// Bright background colors
public const
  clBgBrightBlack: string = "\x1B[100m";
  clBgBrightRed: string = "\x1B[101m";
  clBgBrightGreen: string = "\x1B[102m";
  clBgBrightYellow: string = "\x1B[103m";
  clBgBrightBlue: string = "\x1B[104m";
  clBgBrightMagenta: string = "\x1B[105m";
  clBgBrightCyan: string = "\x1B[106m";
  clBgBrightWhite: string = "\x1B[107m";

// ---------------------------------------------------------------------------
// Input Routines
// ---------------------------------------------------------------------------

// Read a single character (blocking), returns character code
public routine ReadChar(): int32;
begin
  return cpp("std::cin.get()");
end;

// Wait for Enter key
public routine ReadLn();
var
  LCh: int32;
begin
  LCh := cpp("std::cin.get()");
  while (LCh <> 10) and (LCh <> -1) do
    LCh := cpp("std::cin.get()");
  end;
end;

// Pause and wait for keypress
public routine Pause();
begin
  print("Press Enter to continue...");
  cpp("std::cout.flush()");
  ReadLn();
end;

// Pause with custom message
public routine PauseMsg(const AMessage: string);
begin
  println("{}", AMessage);
  cpp("std::cout.flush()");
  ReadLn();
end;

// ---------------------------------------------------------------------------
// Screen Control
// ---------------------------------------------------------------------------

// Clear screen and move cursor to home
public routine ClearScreen();
begin
  print("\x1B[2J\x1B[H");
end;

// Clear current line
public routine ClearLine();
begin
  print("\x1B[2K\r");
end;

// Clear from cursor to end of line
public routine ClearToEndOfLine();
begin
  print("\x1B[K");
end;

// Clear from cursor to end of screen
public routine ClearToEndOfScreen();
begin
  print("\x1B[J");
end;

// ---------------------------------------------------------------------------
// Cursor Visibility
// ---------------------------------------------------------------------------

public routine HideCursor();
begin
  print("\x1B[?25l");
end;

public routine ShowCursor();
begin
  print("\x1B[?25h");
end;

// ---------------------------------------------------------------------------
// Cursor Movement
// ---------------------------------------------------------------------------

// Set cursor position (1-based)
public routine SetCursorPos(const AX: int32; const AY: int32);
begin
  print("\x1B[{};{}H", AY, AX);
end;

// Move cursor up N lines
public routine CursorUp(const ACount: int32);
begin
  print("\x1B[{}A", ACount);
end;

// Move cursor down N lines
public routine CursorDown(const ACount: int32);
begin
  print("\x1B[{}B", ACount);
end;

// Move cursor forward N columns
public routine CursorForward(const ACount: int32);
begin
  print("\x1B[{}C", ACount);
end;

// Move cursor back N columns
public routine CursorBack(const ACount: int32);
begin
  print("\x1B[{}D", ACount);
end;

// Move cursor to beginning of line N lines down
public routine CursorNextLine(const ACount: int32);
begin
  print("\x1B[{}E", ACount);
end;

// Move cursor to beginning of line N lines up
public routine CursorPrevLine(const ACount: int32);
begin
  print("\x1B[{}F", ACount);
end;

// Move cursor to column N (1-based)
public routine CursorToColumn(const AColumn: int32);
begin
  print("\x1B[{}G", AColumn);
end;

// Save cursor position
public routine SaveCursor();
begin
  print("\x1B[s");
end;

// Restore cursor position
public routine RestoreCursor();
begin
  print("\x1B[u");
end;

// ---------------------------------------------------------------------------
// Color Helpers - 256 Color Mode
// ---------------------------------------------------------------------------

// Set foreground color (0-255)
public routine SetFgColor(const AColor: int32);
begin
  print("\x1B[38;5;{}m", AColor);
end;

// Set background color (0-255)
public routine SetBgColor(const AColor: int32);
begin
  print("\x1B[48;5;{}m", AColor);
end;

// ---------------------------------------------------------------------------
// Color Helpers - True Color (24-bit RGB)
// ---------------------------------------------------------------------------

// Set RGB foreground color
public routine SetFgRGB(const AR: int32; const AG: int32; const AB: int32);
begin
  print("\x1B[38;2;{};{};{}m", AR, AG, AB);
end;

// Set RGB background color
public routine SetBgRGB(const AR: int32; const AG: int32; const AB: int32);
begin
  print("\x1B[48;2;{};{};{}m", AR, AG, AB);
end;

// ---------------------------------------------------------------------------
// Reset
// ---------------------------------------------------------------------------

// Reset all attributes
public routine ResetColors();
begin
  print("\x1B[0m");
end;

// Reset and clear screen
public routine Reset();
begin
  ResetColors();
  ClearScreen();
  ShowCursor();
end;

end.
