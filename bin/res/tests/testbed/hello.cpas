  hello.cpas

  Basic lexer test file. Exercises keywords, primitive types, string literals,
  numeric literals, operators, delimiters, identifiers, and comments.
*******************************************************************************/

module exe hello;

const
  MAX_COUNT: int32 = 100;
  PI_VALUE: float64 = 3.14159;
  GREETING: string = "Hello, CPaskal!";

var
  count: int32;
  name: string;
  flag: boolean;

routine add(const a: int32; const b: int32): int32;
begin
  return a + b;
end;

begin
  count := add(10, 20);
  name := "world";
  flag := true;
  println("count = {}", count);
end.