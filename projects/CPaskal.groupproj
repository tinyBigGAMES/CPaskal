<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{9A2B5F2D-80BE-48D9-ACCD-6A57FFBC5EEE}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="ImportLibs\ImportLibs.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="CPAS\cpas.dproj">
            <Dependencies/>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="ImportLibs">
        <MSBuild Projects="ImportLibs\ImportLibs.dproj"/>
    </Target>
    <Target Name="ImportLibs:Clean">
        <MSBuild Projects="ImportLibs\ImportLibs.dproj" Targets="Clean"/>
    </Target>
    <Target Name="ImportLibs:Make">
        <MSBuild Projects="ImportLibs\ImportLibs.dproj" Targets="Make"/>
    </Target>
    <Target Name="cpas">
        <MSBuild Projects="CPAS\cpas.dproj"/>
    </Target>
    <Target Name="cpas:Clean">
        <MSBuild Projects="CPAS\cpas.dproj" Targets="Clean"/>
    </Target>
    <Target Name="cpas:Make">
        <MSBuild Projects="CPAS\cpas.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="ImportLibs;cpas"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="ImportLibs:Clean;cpas:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="ImportLibs:Make;cpas:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
