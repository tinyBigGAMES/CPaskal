<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
    <PropertyGroup>
        <ProjectGuid>{9A2B5F2D-80BE-48D9-ACCD-6A57FFBC5EEE}</ProjectGuid>
    </PropertyGroup>
    <ItemGroup>
        <Projects Include="testbed\testbed.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="CPASLSP\cpaslsp.dproj">
            <Dependencies/>
        </Projects>
        <Projects Include="CPAS\cpas.dproj">
            <Dependencies>testbed\testbed.dproj;CPASLSP\cpaslsp.dproj</Dependencies>
        </Projects>
    </ItemGroup>
    <ProjectExtensions>
        <Borland.Personality>Default.Personality.12</Borland.Personality>
        <Borland.ProjectType/>
        <BorlandProject>
            <Default.Personality/>
        </BorlandProject>
    </ProjectExtensions>
    <Target Name="testbed">
        <MSBuild Projects="testbed\testbed.dproj"/>
    </Target>
    <Target Name="testbed:Clean">
        <MSBuild Projects="testbed\testbed.dproj" Targets="Clean"/>
    </Target>
    <Target Name="testbed:Make">
        <MSBuild Projects="testbed\testbed.dproj" Targets="Make"/>
    </Target>
    <Target Name="cpaslsp">
        <MSBuild Projects="CPASLSP\cpaslsp.dproj"/>
    </Target>
    <Target Name="cpaslsp:Clean">
        <MSBuild Projects="CPASLSP\cpaslsp.dproj" Targets="Clean"/>
    </Target>
    <Target Name="cpaslsp:Make">
        <MSBuild Projects="CPASLSP\cpaslsp.dproj" Targets="Make"/>
    </Target>
    <Target Name="cpas" DependsOnTargets="testbed;cpaslsp">
        <MSBuild Projects="CPAS\cpas.dproj"/>
    </Target>
    <Target Name="cpas:Clean" DependsOnTargets="testbed:Clean;cpaslsp:Clean">
        <MSBuild Projects="CPAS\cpas.dproj" Targets="Clean"/>
    </Target>
    <Target Name="cpas:Make" DependsOnTargets="testbed:Make;cpaslsp:Make">
        <MSBuild Projects="CPAS\cpas.dproj" Targets="Make"/>
    </Target>
    <Target Name="Build">
        <CallTarget Targets="testbed;cpaslsp;cpas"/>
    </Target>
    <Target Name="Clean">
        <CallTarget Targets="testbed:Clean;cpaslsp:Clean;cpas:Clean"/>
    </Target>
    <Target Name="Make">
        <CallTarget Targets="testbed:Make;cpaslsp:Make;cpas:Make"/>
    </Target>
    <Import Project="$(BDS)\Bin\CodeGear.Group.Targets" Condition="Exists('$(BDS)\Bin\CodeGear.Group.Targets')"/>
</Project>
